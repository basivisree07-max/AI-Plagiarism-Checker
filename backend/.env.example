# Required: use a unique random string of at least 32 bytes in production.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# MongoDB connection URI; Docker Compose overrides this to its mongo service.
MONGODB_URI=mongodb://localhost:27017/plagiarism_checker
# Comma-separated exact frontend origins, without trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
